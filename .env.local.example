# -----------------------------------------------------------------------------
# مقدار - إعدادات البيئة المحلية لمشروع الأعمال (Miqdar Business)
# -----------------------------------------------------------------------------

# رابط الاتصال بقاعدة بيانات PostgreSQL الخارجية (مثال: Supabase, Neon, or local Postgres)
# قم بنسخ هذا الملف وتسميته باسم `.env.local` وتعبئة المتغير أدناه.
# في حال عدم وجود هذا المتغير، سيعمل النظام تلقائياً بوضع الحفظ المحلي (JSON Files) في المجلد `/data`.

DATABASE_URL="postgres://username:password@hostname:port/database_name?sslmode=require"
